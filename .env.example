# Copy to .env and fill in. .env is git-ignored; never commit real values.

# ---- Accounts and login (app/auth.py) ----
# Key that signs login tokens. Use a long random value (at least 32 characters).
# If empty, one is generated on first start and kept in data/.jwt_secret.
JWT_SECRET=
# Access-token lifetime in minutes; the app renews it with the refresh token, so users stay logged in
JWT_EXPIRE_MINUTES=15
# How long a log-in lasts without being used, in days (refresh-token lifetime)
REFRESH_EXPIRE_DAYS=7
# Who may create an account: invite (the default: an invite code is required and decides the tenant),
# open (anyone may also sign up without a code, into the shared default tenant, which holds every document
# indexed before tenants existed), or closed (only an admin creates accounts with scripts/manage_users.py
# or POST /auth/users)
SIGNUP_MODE=invite
# Deprecated: fixed invite codes that never expire (code:tenant,...). Prefer invites created in the app
# (Admin page), with POST /auth/invites or with scripts/manage_users.py create-invite: they expire, have a
# use limit and can be revoked.
INVITE_CODES=
# New accounts allowed per client /24 network per hour
SIGNUPS_PER_SUBNET_PER_HOUR=5
# Failed log-ins (all usernames together) allowed per client /24 network per hour. Five failures lock an
# account only for the network they came from, so nobody can lock another person out from elsewhere.
LOGIN_FAILURES_PER_SUBNET_PER_HOUR=30
# Optional: create this admin account on first start (or use scripts/manage_users.py create --role admin)
ATTS_ADMIN_USERNAME=
ATTS_ADMIN_PASSWORD=

# Local Ollama model used for answers and for the ingestion injection judge
OLLAMA_MODEL=llama3

# Folder holding local copies of downloaded models, one sub-folder per model named like its Hugging Face repo
# (e.g. D:/ATTS-RAG-models/paraphrase-multilingual-MiniLM-L12-v2). Used before the Hugging Face cache when present.
ATTS_MODEL_DIR=

# Set to 1 after the first run has downloaded the embedding and reranking models.
# Stops HuggingFace from checking for model updates over the network on every start.
HF_HUB_OFFLINE=
