# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Enables admin uploads: any source tier other than "unknown", and new versions of an
# existing document ID. Use a long random value. Leave empty to disable admin uploads.
ADMIN_TOKEN=

# Local Ollama model used for answers and for the ingestion injection judge
OLLAMA_MODEL=llama3

# Set to 1 after the first run has downloaded the embedding and reranking models.
# Stops HuggingFace from checking for model updates over the network on every start.
HF_HUB_OFFLINE=

# Clerk Authentication Keys (From Clerk Dashboard > Manual setup or API Keys)
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

