# Copy to .env and fill in. .env is git-ignored; never commit real values.

# ---- Accounts and login (app/auth.py) ----
# Key that signs login tokens. Use a long random value (at least 32 characters).
# If empty, one is generated on first start and kept in data/.jwt_secret.
JWT_SECRET=
# Access-token lifetime in minutes; the app renews it with the refresh token, so users stay logged in
JWT_EXPIRE_MINUTES=15
# How long a log-in lasts without being used, in days (refresh-token lifetime)
REFRESH_EXPIRE_DAYS=7
# Who may create an account: invite (the default: an invite code is required and decides the tenant),
# open (anyone may also sign up without a code, into the shared default tenant, which holds every document
# indexed before tenants existed), or closed (only an admin creates accounts with scripts/manage_users.py
# or POST /auth/users)
SIGNUP_MODE=invite
# Deprecated: fixed invite codes that never expire (code:tenant,...). Prefer invites created in the app
# (Admin page), with POST /auth/invites or with scripts/manage_users.py create-invite: they expire, have a
# use limit and can be revoked.
INVITE_CODES=
# New accounts allowed per client /24 network per hour
SIGNUPS_PER_SUBNET_PER_HOUR=5
# Failed log-ins (all usernames together) allowed per client /24 network per hour. Five failures lock an
# account only for the network they came from, so nobody can lock another person out from elsewhere.
LOGIN_FAILURES_PER_SUBNET_PER_HOUR=30
# Optional: create this admin account on first start (or use scripts/manage_users.py create --role admin)
ATTS_ADMIN_USERNAME=
ATTS_ADMIN_PASSWORD=
# Roles that must use two-factor log-in (authenticator app), e.g. tenant_admin,super_admin. Empty: optional.
REQUIRE_2FA_ROLES=
# Key that encrypts stored 2FA secrets. If empty, one is generated into data/.totp_key: back it up with
# data/users.db, because losing it disables every enrolled authenticator.
TOTP_KEY=
# Audit log of log-ins and account changes (hash-chained JSON lines)
AUTH_AUDIT_LOG=logs/auth_audit.jsonl

# Local Ollama model used for answers and for the ingestion injection judge
OLLAMA_MODEL=llama3
# Model calls at the same time. One CPU-bound Ollama is no faster in parallel, so the default of 1 lets each
# call run at full speed while the others wait their turn. Raise it on a GPU host.
OLLAMA_MAX_CONCURRENCY=1

# ---- Streamlit app ----
# Backend address, and how long the app waits for an answer (seconds). Keep the timeout well above the
# backend's worst case: on a CPU an answer takes 1-2 minutes, longer when other questions are queued.
ATTS_API_URL=http://127.0.0.1:8000
ATTS_QUERY_TIMEOUT=900

# Folder holding local copies of downloaded models, one sub-folder per model named like its Hugging Face repo
# (e.g. D:/ATTS-RAG-models/paraphrase-multilingual-MiniLM-L12-v2). Used before the Hugging Face cache when present.
ATTS_MODEL_DIR=

# ---- Monitoring (docs/Operations_Runbook.md) ----
# Read-only token for GET /health/details and GET /metrics (at least 24 characters; shorter values are refused).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(36))"
MONITOR_TOKEN=
# Alarm limits for free disk space where data/, chroma_db/ and logs/ live
DISK_MIN_FREE_GB=5
DISK_MIN_FREE_PCT=10
# JSON-lines logs (traces, feedback, Layer 3 audit, admin-view audit, log-in audit) move to logs/archive/ at this size.
# LOG_ARCHIVE_DAYS deletes plain-log archives older than that; empty keeps them. Log-in audit archives are always kept.
LOG_MAX_MB=20
LOG_ARCHIVE_DAYS=

# ---- Backups (scripts/backup.py) ----
# Output folder, and the age PUBLIC key backups are encrypted to (age-keygen -o key.txt prints it). Keep the private
# key file away from the backups and the server: without it no backup can be restored.
BACKUP_DIR=
BACKUP_AGE_RECIPIENT=
# Paths of age and rclone when they are not on PATH
AGE_BIN=
RCLONE_BIN=
# Off-site copy with rclone (e.g. gdrive:ATTS-RAG-backups; run rclone config first). Only encrypted files are sent.
BACKUP_REMOTE=
# Push monitor called after each run (Uptime Kuma push URL): status=up on success, status=down on failure
BACKUP_HEARTBEAT_URL=
# Retention: daily,weekly,monthly
BACKUP_KEEP=7,4,6
# The backup health check fails after this many hours without a successful backup; BACKUP_CHECK=off disables it
BACKUP_MAX_AGE_HOURS=26

# Set to 1 after the first run has downloaded the embedding and reranking models.
# Stops HuggingFace from checking for model updates over the network on every start.
HF_HUB_OFFLINE=
