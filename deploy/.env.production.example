# Copy to deploy/.env on the server:   cp .env.production.example .env
# deploy/setup-host.sh does this for you and fills in the two keys. .env is git-ignored; never commit it.

# ---- Public address (read by Caddy) ----
# A DNS name that points to the server gives HTTPS automatically. ":80" is plain HTTP for a first test only.
DOMAIN=:80

# ---- Accounts and login ----
# Long random values. setup-host.sh generates both. Back up TOTP_KEY together with the user database:
# losing it disables every enrolled authenticator.
JWT_SECRET=
TOTP_KEY=
SIGNUP_MODE=invite
REQUIRE_2FA_ROLES=tenant_admin,super_admin
JWT_EXPIRE_MINUTES=15
REFRESH_EXPIRE_DAYS=7
# Do not set INVITE_CODES (deprecated, never expire). Create invites on the Admin page instead.
# Do not set ATTS_ADMIN_PASSWORD here. Create the first administrator with manage_users.py (see DEPLOY_AWS.md).
ATTS_ADMIN_USERNAME=
ATTS_ADMIN_PASSWORD=
AUTH_AUDIT_LOG=logs/auth_audit.jsonl

# The console calls the API from inside the server, so the API sees every user at one network address and
# the per-network limits below act as limits for ALL users together. The values are therefore higher than
# the defaults (5 and 30). Lower them again if you put the API behind a proxy that forwards the real address.
SIGNUPS_PER_SUBNET_PER_HOUR=50
LOGIN_FAILURES_PER_SUBNET_PER_HOUR=300

# ---- Model ----
OLLAMA_MODEL=llama3
# 1 on a CPU server. On a GPU server (docker-compose.gpu.yml) 2 is a reasonable start; measure first.
OLLAMA_MAX_CONCURRENCY=1
# Seconds the console waits for an answer; keep above the worst case with queued questions.
ATTS_QUERY_TIMEOUT=900

# Leave empty for the first start so the embedding, re-ranking and NLI models are downloaded.
# Then set to 1 and restart, so nothing is fetched from the network any more.
HF_HUB_OFFLINE=
ATTS_MODEL_DIR=
